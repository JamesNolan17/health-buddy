# healthy-wealthy 配置。复制成 .env 再改 / copy to .env and edit.
# 注释请单独成行（docker compose 以外的工具不一定认行尾注释）

# ===== 必填 Required =====
# Telegram 机器人令牌：找 @BotFather 发 /newbot
TELEGRAM_BOT_TOKEN=123456:ABC-replace-me
# 你的 Telegram 数字 ID（找 @userinfobot）。只有这个 ID 能指挥它 / only this chat may talk to the bot
OWNER_CHAT_ID=123456789
# 收件口密钥，手机 / Home Assistant 往里推数据时要带上：openssl rand -hex 24
INBOX_TOKEN=change-me-to-a-long-random-string

# ===== 模型 Model：A / B / C 三选一，把选中的那组去掉 # / uncomment exactly ONE option =====
# A) Anthropic API key（按量计费 / pay as you go）
#ANTHROPIC_API_KEY=sk-ant-...
# B) Claude 订阅（Pro / Max）：在任意装了 Claude Code 的电脑上运行 `claude setup-token`，把输出贴进来
#CLAUDE_CODE_OAUTH_TOKEN=...
# C) 兼容 Anthropic 协议的其他模型（DeepSeek / Kimi / GLM / OpenRouter / LiteLLM …），见 README「换模型」
#ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
#ANTHROPIC_AUTH_TOKEN=sk-...
#ANTHROPIC_MODEL=deepseek-chat
#ANTHROPIC_SMALL_FAST_MODEL=deepseek-chat

# ===== 可选 Optional =====
# 容器时区：定时任务按这个时区跑 / schedules run in this timezone
TZ=Asia/Shanghai
# 收件口绑定地址。默认 127.0.0.1 只有本机能访问；填你的 Tailscale IP（100.x.x.x）或内网 IP 让手机能推数据。
# 不要填 0.0.0.0 后再把端口暴露到公网 / your Tailscale or LAN IP; never a public interface
#INBOX_BIND=127.0.0.1
#INBOX_PORT=8790
#INBOX_SOURCES=health,pay,ha
#INBOX_MAX_MB=200
# 换 agent：AGENT=cmd 时用任意命令行 agent，prompt 从 stdin 进、回复从 stdout 出 / any CLI agent
#AGENT=claude
#AGENT_CMD=
#AGENT_TIMEOUT=1800
# 需要代理才能访问 Telegram / 模型 API 时 / proxy if Telegram or the model API is blocked where you live
#HTTPS_PROXY=http://...
#NO_PROXY=homeassistant.local,192.168.0.0/16
