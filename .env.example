# ===== 必填 Required =====
TELEGRAM_BOT_TOKEN=123456:ABC...         # 找 @BotFather 新建机器人
OWNER_CHAT_ID=123456789                  # 你的 Telegram 数字 ID（找 @userinfobot）
INBOX_TOKEN=change-me-to-a-long-random-string   # 收件口密钥：openssl rand -hex 24

# ===== 模型 Model（三选一 / pick one）=====
# A) Anthropic API key
ANTHROPIC_API_KEY=sk-ant-...
# B) Claude 订阅（Pro/Max）：在任意装了 Claude Code 的电脑上运行 `claude setup-token`
# CLAUDE_CODE_OAUTH_TOKEN=...
# C) 兼容 Anthropic 协议的其他模型（DeepSeek / Kimi / GLM …），见 README
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
# ANTHROPIC_AUTH_TOKEN=sk-...
# ANTHROPIC_MODEL=deepseek-chat
# ANTHROPIC_SMALL_FAST_MODEL=deepseek-chat

# ===== 可选 Optional =====
TZ=Asia/Shanghai
# INBOX_PORT=8790
# INBOX_SOURCES=health,pay,ha
# INBOX_MAX_MB=200
# AGENT=claude            # 或 cmd：用任意命令行 agent，prompt 从 stdin 进、回复从 stdout 出
# AGENT_CMD=              # AGENT=cmd 时的命令
# AGENT_TIMEOUT=1800
# HTTPS_PROXY=http://...  # 需要代理才能访问 Telegram / 模型 API 时
# NO_PROXY=homeassistant.local,192.168.0.0/16
